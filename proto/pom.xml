<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId><artifactId>RAG-V1</artifactId><version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>proto</artifactId>
    <name>proto</name>
    <description>根级 proto 契约模块 —— 集中承载 10 个业务域的 .proto（L1 外部契约），生成 protobuf + gRPC Java 代码</description>

    <dependencies>
        <dependency>
            <groupId>io.grpc</groupId><artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId><artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId><scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <!--
              build extension 不继承 pluginManagement 的版本（实测：省略 <version> 会报
              "Unresolveable build extension: Error resolving version for plugin 'kr.motd.maven:os-maven-plugin'"），
              故此处显式写版本，与 service/*/contract 的既有写法一致。
              另注：根 pom 的 pluginManagement 里 os-maven-plugin 用了错误 groupId（org.xolstice.maven.plugins），
              实际 groupId 是 kr.motd.maven —— 该条目在本模块用不到，不在本任务改动范围内。
            -->
            <extension>
                <groupId>kr.motd.maven</groupId><artifactId>os-maven-plugin</artifactId><version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>compile</goal><goal>compile-custom</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                抄 RAG 10 个 `*-proto/pom.xml` 的同名插件（**本仓因 D7 集中到根级 proto ⇒ 只改这 1 处**）：
                **构建期守门** —— 禁掉 `protobuf-java` / `protobuf-javalite` 的低版本。

                ⚠️ **为什么需要它**：本仓实测**不搬** `protobuf-javalite` / `grpc-protobuf-lite`
                （RAG 生成的 proto 源码 0 处引用 lite 类）⇒ ⇒ 但「不搬」是**约定**，不是**机制**：
                任何人加一条 lite 依赖、或某个上游把 protobuf 降到 ≤3.25.4，都会**静默**改变
                运行时行为（lite 与 full 的 `GeneratedMessage` 家族不兼容 ⇒ 运行期
                `ClassCastException` / `NoSuchMethodError`，不是编译期报错）。
                ⇒ ⇒ 用 enforcer 把这条约定**变成构建期红**。

                ⚠️ **规则语义**：`[,3.25.4]` = 版本区间「≤ 3.25.4」⇒ 被禁。
                本仓 `protobuf.version` = **3.25.5** ⇒ 自身合规。
                `searchTransitive=true` ⇒ **传递依赖**里的低版本也会被拦下（真正的守门点）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-banned-dependencies</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.google.protobuf:protobuf-javalite:[,3.25.4]</exclude>
                                        <exclude>com.google.protobuf:protobuf-java:[,3.25.4]</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
