<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId><artifactId>users</artifactId><version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>users-common</artifactId>
    <name>users-common</name>
    <description>users 域（user + admin）共享契约 —— Go 侧 service/user/common/errmsg 的对应物</description>

    <dependencies>
        <dependency>
            <groupId>io.grpc</groupId><artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId><scope>provided</scope>
        </dependency>
        <!--
            ══ 抄自 RAG 仓 `service/users/users-common/pom.xml` ══
            ⚠️ **D14 · 工具链回退**：`jjwt-jackson`（Jackson 2）**恢复照抄** ⇒ 不再需要自写
               `tools.jackson` `Serializer`（`IdentityResolver` / `common/security/JwtUtil.java` 直接用它）。
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId><scope>runtime</scope>
        </dependency>
        <!--
            Jackson 2 —— `IdentityResolver` 要解析 JWT claims。
            版本由根 pom 的 `com.fasterxml.jackson:jackson-bom` 统一管（2.19.4，与 Boot 3.5.11 同版本）。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId>
        </dependency>
        <!--
            口令散列（`PasswordUtil`）—— Spring Security 的 `BCryptPasswordEncoder`
            ⇒ **不用**自己实现散列（§3.2「生态优先」）。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId><artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- JDBC（`users-common` 要经 JDBC 读用户表做 status presence 检查） -->
        <dependency>
            <groupId>org.springframework</groupId><artifactId>spring-jdbc</artifactId>
        </dependency>
        <!--
            Servlet API —— `IdentityResolver` 从 `HttpServletRequest` 的 attribute 取 claim。

            ⚠️ **为什么是 `provided`**：本模块是**库** ⇒ servlet 容器由消费方（user-service /
            admin-service，两者都有 `spring-boot-starter-web`）提供 ⇒ 库不应把 servlet 容器拖进来。
            ⚠️ **`provided` 也不传递给下游**：消费方自己声明的 `spring-boot-starter-web` 才是真源。
            ⚠️ **版本由 Boot BOM 管**（`jakarta.servlet:jakarta.servlet-api` ⇒ Boot 3.5 = 6.0.x）。
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><scope>provided</scope>
        </dependency>
        <!--
            SLF4J —— `SchemaInitializer` 记日志（抄 B 的 `SchemaInitializer`，它用 slf4j）。
            ⚠️ **只引 api，不引 logback**：日志实现由消费方（各 app 的 `spring-boot-starter-logging`）决定。
        -->
        <dependency>
            <groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ============ 测试基础设施（test 作用域**不传递给下游**） ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Testcontainers + PG 驱动 —— `SchemaInitializer` 的 DDL 重放与 `JdbcUserStatusLookup`
            的 status presence 判定**必须跑在真 PostgreSQL 上**（H2 不认 `TIMESTAMPTZ` / `ALTER ... TYPE` /
            `SET TIME ZONE`，会假绿）。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId><artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId><artifactId>os-maven-plugin</artifactId><version>1.7.1</version>
            </extension>
        </extensions>
    </build>
</project>
