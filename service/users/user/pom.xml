<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId><artifactId>users</artifactId><version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>user-service</artifactId>
    <name>user-service</name>
    <description>user 域 —— api + rpc 合并后的单一 Spring Boot 应用</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
            ⚠️ **Nacos 3.0.3 单一真源（D14）** —— 版本由**根 pom 的 `dependencyManagement`** 统一管
            （`nacos.version` = 3.0.3 = spring-cloud-alibaba 2025.0.0.0 的原生版本 ⇒ 无需覆盖）。
            ⚠️ **不再排除 Jackson 2**（D14 工具链回退）：nacos-client 3.0.3 内部**依赖** Jackson 2
            ⇒ 排除即客户端启动即 NoClassDefFoundError。
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- ============ DDL 建表：**不用 Flyway**（照抄 B 侧 users 域） ============ -->
        <!--
            B 侧 `service/users/{user,admin,users-common}` 三个 pom **均无 Flyway 依赖**
            ⇒ 建表走 `users-common` 的 `SchemaInitializer`（幂等重放 `db/01..04_*.sql`，
               advisory lock 串行化 ⇒ 谁先启动都行，重复重放恒等）
            ⇒ **D16**：B 侧是唯一真理 ⇒ 本仓照抄，**不引 Flyway**
            ⇒ 顺带消除「两个域共用默认账本表 `flyway_schema_history`」的撞号隐患
               （users 域无版本化账本 ⇒ 不存在账本撞号）
        -->
        <!-- ============ 测试基础设施（抄 RAG；test 作用域**不传递给下游**） ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            🔴🔴 grpc-inprocess **必须是运行时依赖（不能是 test scope）** —— 2026-11-03 双侧活体对拍实测

            现象：C 侧 fat jar **启动即挂**：
              NoClassDefFoundError: io/grpc/inprocess/InProcessChannelBuilder
                at net.devh.boot.grpc.client.autoconfigure.GrpcClientAutoConfiguration
                     .shadedNettyGrpcChannelFactory(GrpcClientAutoConfiguration.java:160)
              ⇒ 上下文 refresh 失败 ⇒ **整个进程起不来**（健康检查 / 容器启动全部失败）。

            根因：devh 的 `grpc-client-spring-boot-starter` 3.1.0.RELEASE 的
            `GrpcClientAutoConfiguration#shadedNettyGrpcChannelFactory` 在**运行期**就要
            `io.grpc.inprocess.InProcessChannelBuilder`（D1 把 api+rpc 合成单进程 ⇒ client starter 也在 ⇒
            该 auto-config 会装配 ⇒ 缺类即炸）。
            ⇒ 而本模块原先把 grpc-inprocess 声明成 **test scope** ⇒ **只在测试类路径上有** ⇒
            ⇒ **39 例测试全绿（测试类路径带这个类），但生产 jar 起不来**。

            B 出处（类路径口径以 B 侧为准）：B 侧两个 fat jar **都含** `BOOT-INF/lib/grpc-inprocess-1.63.0.jar`
              service/users/user/user-api/target/user-api-0.0.1-SNAPSHOT.jar
              service/users/user/user-rpc/target/user-rpc-0.0.1-SNAPSHOT.jar
            ⇒ B 的**运行时**类路径带这个类 ⇒ B 能起 ⇒ ⇒ C 必须同口径。

            教训（⇒ docs/Pitfalls/users/_user-domain-pitfalls.md）：**测试类路径 ≠ 生产 jar 类路径** ⇒
            「mvn test 全绿」证不了「fat jar 起得来」⇒ ⇒ 必须真跑一次 fat jar。
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            ⚠️ **grpc-core 显式声明 + starter 上排除**（抄 RAG 的 rpc 模块）：
            devh 的 `grpc-*-spring-boot-starter` 3.1.0.RELEASE 会拖自己的 `grpc-core`
            ⇒ 在引入起点 exclude，版本只由根 pom 的 `grpc.version`（1.63.0）决定。
        -->
        <dependency>
            <groupId>io.grpc</groupId><artifactId>grpc-core</artifactId>
        </dependency>
        <dependency>
            <groupId>net.devh</groupId><artifactId>grpc-server-spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.devh</groupId><artifactId>grpc-client-spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId><artifactId>proto</artifactId><version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId><artifactId>users-common</artifactId><version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId><artifactId>common</artifactId><version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
            ⚠️ **commons-pool2 不可省**（抄 RAG 的 5 个模块）—— Boot 3.5 的 `spring-boot-starter-data-redis`
            **同样不再传递** commons-pool2（只有 lettuce-core），而本域的 `application.yml` 一旦配
            `spring.data.redis.lettuce.pool.enabled: true` ⇒ LettuceConnectionConfiguration 会构造
            `org.apache.commons.pool2.impl.GenericObjectPoolConfig`
            ⇒ 缺它启动即 `NoClassDefFoundError`（RAG 侧实测记录：`docs/DRIFT/like/rpc.md`）。
            版本由 spring-boot-dependencies BOM 管理（2.12.1），不写 <version>。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId><artifactId>commons-pool2</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
